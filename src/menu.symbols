random_words          0x00000cc6  uint8_t *%s
level_map          0x00000b86  uint8_t *%s
copper_colours          0x00000cda  uint8_t *%s
unit_member_blocks         0x00000cfa  uint8_t *%s[5]   five pointers, 200 bytes apart (the first is set by memory_map_init)
message_offsets          0x00000cba  uint8_t *%s
unused_buffer_10          0x00000bce  uint8_t *%s
bolt_slots          0x00000cce  uint8_t *%s
path_records          0x00000c9e  struct PathRecord *%s
unused_scratch_alias          0x00000bb2  uint8_t *%s
scratch_buffer          0x00000e44  uint8_t *%s
message_text_block          0x00000e5c  uint8_t *%s
unit_scripts          0x00000cb2  uint8_t *%s
cell_entry_table          0x00000cbe  struct EntryRef *%s
creature_entries          0x00000d0e  struct CreatureEntry *%s
monster_types          0x00000ce6  uint8_t *%s
path_description_base          0x00000c9a  const struct PathDescription *%s
hint_list          0x00000cf2  uint8_t *%s
program_end       0x0003a670  uint8_t %s[]      the end of the program as the loader reads it: the memory map begins here
voice             0x0002034c  struct Voice %s[4]   the four voices of the sound system (the state of the sound system goes on after them)
voice_buffers     0x0002061c  uint8_t %s[]      a buffer of 128 bytes for each voice
sound_lock        0x0002079c  uint8_t %s        $FF while the sound system is being set up
creature_types      0x000199ac  uint8_t %s[]      records of 36 bytes whose first long is a pointer (these are 140 bytes apart)     records of 36 bytes whose first long is a pointer (set up at the start)
loading_text      0x0001d3f4  uint8_t %s[]      "loading game please wait"
palette_words     0x00000134  uint16_t %s[16]   the sixteen colours of the picture assets_load read last
first_asset_name  0x000196d6  char %s[]         "always": the name of the first asset set
table keymap      0x0001e5ae uint8_t 128   the character a raw key code gives (0 when none)
copper_save_second          0x00000e58  uint8_t *%s
random_seed       0x0001d0aa  uint16_t %s       the seed of the program's random numbers (a word in the code)
scroll_ease_phase         0x0000037c  uint16_t %s
unused_5418         0x00005418  uint16_t %s
unused_240         0x00000240  uint16_t %s
play_starting         0x00000248  uint16_t %s
asset_end_28ec    0x000028ec  uint8_t *%s       a copy of where assets_load ended
asset_table_28f0  0x000028f0  uint8_t *%s       ... and of its table's end
unused_28ea         0x000028ea  uint16_t %s
asset_end_0ca2    0x00000ca2  uint8_t *%s
asset_table_0ca6  0x00000ca6  uint8_t *%s
unused_25c         0x0000025c  uint16_t %s
world_b_files         0x00000266  uint16_t %s
world_loading         0x00000384  uint16_t %s
image_draw_flags        0x00000ddd  uint8_t %s
original_start    0x0000240c  void %s(void)    the original's start-up after the chips are set up: it loads the copy protection's stub and runs it (not in C)
original_begin    0x0000651e  void %s(void)    the original's Begin Quest (replaced by begin_quest in game_h.c, no longer called)
original_continue 0x00006650  void %s(void)    ... and Continue Game
original_after_password 0x000064c2 void %s(void)   the original's code after the password screen
menu_start_code   0x00006388  uint8_t %s[6]   the first instruction of the original's menu start: replaced by a jump to menu_start
table background_name 0x000026d2 char 12   "backscr.pi1": the file of the menu's background picture
table small_font_name 0x00003232 char 9    "smallfnt": the asset set of the small font
drives_present   0x0001d48c  uint8_t %s      bit n set: drive n is there (the start finds them)
# the game's own routines, not decompiled yet: provisional names by address (a name is changed when the routine is written in C)
orig_scroll_push           0x000030c6  void %s(void)
orig_update_records           0x0000417c  void %s(void)
orig_update_creatures           0x00006ed0  void %s(void)
