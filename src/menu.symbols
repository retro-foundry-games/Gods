fire_latch        0x00000222  int16_t %s   cleared while fire is up
energy_old      0x00000c98  uint16_t %s   the energy of the frame before
player_energy          0x00000c96  uint16_t %s   the player's energy (0 to 24)
energy_shown        0x00000216  int16_t %s   the energy as shown (it goes toward player_energy a step a frame); 0 or less: the player is dead (the loop goes on elsewhere)
scroll_push_frames          0x0000026e  uint16_t %s
boss_mode          0x0000023a  uint16_t %s
scroll_x          0x00000358  int16_t %s   the screen's position in the level
scroll_y          0x0000035a  int16_t %s
scroll_x_a        0x0000029a  int16_t %s   the scroll position kept while the loop runs
scroll_y_a        0x0000029c  int16_t %s
scroll_x_b        0x0000029e  int16_t %s
scroll_y_b        0x000002a0  int16_t %s
world_end_steps          0x00000290  int16_t %s
energy_pickup_active          0x00000268  uint16_t %s
unused_2b0          0x000002b0  uint16_t %s
level_ended          0x00000230  uint16_t %s
frame_wait        0x000001dc  uint16_t %s   frames of a game frame, less one (the flip waits for more than this many)
boss_load_request          0x00000258  uint16_t %s
door_entered          0x000001f0  uint16_t %s
event_flags         0x000003b0  uint8_t %s
hit_list_last          0x0000020e  int16_t %s
hit_list_offset         0x00000c6c  uint32_t %s
game_record_ptr   0x00000bd2  uint8_t *%s    where the input of this frame is recorded when demo_mode is positive
onscreen_count    0x000002b8  uint16_t %s     how many things were counted as on the screen this frame
game_buttons      0x00000228  uint8_t %s     the button bits of this frame (bit 0 fire); the menu uses it as "the button is still down since it picked a cell of the grid"
stone_records      0x0000113c  struct Slot12 %s[10]   ten records of 12 bytes (the second word is not 0 for one in use)
pickup_spots     0x00019334  struct Slot8 %s[20]    twenty records of 8 bytes (the third word is not negative for one that is in use)
thing_records     0x00019b14  struct Slot8 %s[200]   two hundred records of 8 bytes (the second word is negative for one that is free)
