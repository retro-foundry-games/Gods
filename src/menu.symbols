# The menu program's data: name, address, C declaration (%s is the name), what it is.  scripts/gen_menu_symbols.py writes
# native/menu_symbols.h (the declarations) and native/menu.ld (the names at their addresses), so the C names no address.
work_area         0x00000caa  uint32_t *%s    pointer to a buffer of 80 longs that clear_work_area clears
shadow_table      0x00000e10  uint16_t %s[]   a table of words indexed by shadow_set / shadow_get (colour register shadows)
mouse_x           0x0001e4fc  uint16_t %s     pointer position, 0 to $200 (moved by input_poll)
mouse_y           0x0001e4fe  uint16_t %s     pointer position, 0 to $C7
mouse_x_copy      0x0001e500  uint16_t %s
mouse_y_copy      0x0001e502  uint16_t %s
button_bits       0x0001e504  volatile uint8_t %s[2]   bit 0: a button down (either), bit 1: the second; cleared at the start of every poll
mouse_counter     0x0001e506  volatile uint16_t %s     JOY0DAT as last read: vertical counter in the high byte, horizontal in the low byte
mouse_counter_old 0x0001e508  volatile uint16_t %s     the value before it
button_presses    0x0001e50a  volatile uint8_t %s      bits set by input_poll (1 first button, 4 second or the pot lines), cleared by whoever reads them
pending_request   0x0001e5a8  volatile uint32_t %s     non-zero: something is waiting to be taken (take_pending_request)
key_down          0x0001e63a  volatile uint8_t %s[128]   $FF for each key (by its raw key code) that is held down, kept by the keyboard interrupt
joystick          0x0001e5ac  volatile uint8_t %s      bit 0 up, 1 down, 2 left, 3 right, 7 fire
heap_base         0x0000002c  uint32_t %s     where the program's memory starts (a vector slot the program uses for it)
mem_lists         0x0001d41c  struct MemLists %s   the allocator's two lists (alloc_init)
param_index       0x000001d4  uint16_t %s     which row of param_table select_params takes (1 to 4)
param_a           0x0000024c  uint32_t %s     set by select_params
param_b           0x00000250  uint32_t %s
param_c           0x00000254  uint16_t %s
param_d           0x00000256  uint16_t %s
entry_list        0x00000cae  struct Entry8 *%s   a list of address/size entries that assign_addresses fills in
words_source      0x00000cbe  const uint16_t *%s   words that narrow_words_to_bytes makes bytes of
bytes_dest        0x00000cc2  uint8_t *%s     ... and where the bytes go
buffer_cb6        0x00000cb6  uint8_t *%s     a buffer of 2400 bytes that load_buffer_2400 fills
saved_slot_words  0x000148e8  uint16_t %s[22]   two words of each of the eleven slots, put away by save_slot_words
object_slots      0x00014988  struct Rec80 %s[11]   eleven records of 80 bytes
table_14cf8       0x00014cf8  struct Rec10 %s[132]   built by build_table_14cf8
marker_table      0x0001a3fc  uint32_t %s[100]   set to -1 by reset_marker_table
record_table      0x0001a58c  struct Rec6 %s[200]   copied in by copy_record_table
entry_table       0x0003a25e  struct Rec6 %s[50]   cleared by clear_entry_table
table param_table  0x000029da uint16_t 24   four rows of 12 bytes (two longs, two words) that select_params takes
table offsets_4cba 0x00004cba uint8_t 132   signed bytes that build_table_14cf8 puts in the table
blit_extra_modulo 0x000003b4  uint16_t %s     the blitter's extra modulo for the masked blit (0 unless set)
blit_plane_stride 0x000003b6  uint32_t %s     bytes from one plane of the screen to the next
mask_buffer       0x00000e48  uint16_t *%s    the buffer the blit makes its mask in
screen_buffer     0x00000e60  uint8_t *%s     the screen that is drawn to
image_table       0x00000e3c  struct Image *%s   the images (and glyphs) of the program
glyph_plane_size  0x00000280  uint16_t %s     non-zero: bytes of one plane of a glyph, otherwise worked out from its height
x_offset          0x0001d3a4  int16_t %s      added to the x of everything that is drawn
glyph_base        0x00000270  uint16_t %s     added to the index of what draw_string_small and the digit printer draw (the small font)
text_y            0x00012d5a  uint16_t %s     the row text_draw_centered draws at (a word in the middle of the code)
last_request      0x0000049e  uint16_t %s     the request next_request returned last time
repeat_delay      0x0000049c  int16_t %s      frames before next_request repeats a request that is held; counted down elsewhere
screen_other      0x00000e64  uint8_t *%s     the other screen: the one that is shown while screen_buffer is drawn on
copper_save       0x00000e50  uint16_t *%s    where copper_colors_save puts the colours of the copper list, and the fades take their target from
palette_dirty     0x00000e0e  uint16_t %s     non-zero: the vertical blank copies the shadow table to the colour registers
buffer_state      0x00000de4  struct Rec6 %s[2]   what is kept for each of the two screens; swapped when they are
vbl_saturating    0x0001d058  volatile uint16_t %s     frames since the last flip, stops at $7FFF
vbl_count         0x0001d05a  volatile uint16_t %s     frames, wraps
copper_colors     0x00004e3a  uint16_t %s[]   the part of the copper list that has the moves to COLOR01 (the colour of each band)
copper_list_a     0x00004d8a  uint8_t %s[]    the copper list of one screen
copper_list_b     0x00004dde  uint8_t %s[]    ... and of the other
screen_1          0x0006f800  uint8_t %s[]    the two screens
screen_2          0x00077c00  uint8_t %s[]
copper_setup_done 0x000002f2  uint16_t %s     non-zero: the copper list's two moves at copper_move_a / copper_move_b are set already
copper_move_a     0x00004e2e  uint32_t %s     two words of the copper list (a register move) that fade_in and fade_out set
copper_move_b     0x00004e32  uint32_t %s
palette_lit       0x0001d3f3  uint8_t %s      $FF after fade_in (the screen has its colours), 0 after fade_out
copper_a_scroll   0x00004d90  uint16_t %s     the scroll word in the first copper list (set by the frame tick)
copper_b_scroll   0x00004de4  uint16_t %s     ... and in the second
scroll_value      0x00000e12  uint16_t %s     what the frame tick puts in both once the copper list is set up
sound_enabled     0x000002f6  uint16_t %s     non-zero: the frame tick runs the sound
tick_count        0x00000ce2  volatile uint32_t %s     frames the tick has run
countdown_220     0x00000220  volatile uint16_t %s     counted down to 0 by the frame tick
tick_hold_38a     0x0000038a  uint16_t %s     the frame tick does its message work only while these three are 0
tick_hold_296     0x00000296  uint16_t %s
tick_hold_26c     0x0000026c  uint16_t %s
message_state     0x00000b2a  int16_t %s      0 none, -1 colours fading in, 1 colours fading out
message_timer     0x00000b2c  int16_t %s      steps left of the fade
message_current   0x00000b26  const uint8_t *%s   the text to show (0 none), message_start takes it from message_next
message_next      0x00000b32  const uint8_t *%s
message_text      0x00000b2e  const uint8_t *%s   the text that was drawn
message_x         0x00000b36  int16_t %s      where the text starts (in characters, less 8)
message_wide      0x00000b38  int16_t %s      -1 text fits, 320 it does not
message_shown     0x000002f4  uint16_t %s     non-zero: the message is on the screen
message_arg       0x000002f8  uint16_t %s
message_words     0x000053ee  uint16_t %s[16]   colours of the message (message_words[8..11] the colours it fades to)
table message_pairs 0x00016f6e uint32_t 8   four pairs of addresses of the two copper lists' colour moves the message fades
table font_8x8     0x0001e7f4 uint8_t 1272  the text font (8 bytes a character)
memory_base       0x00000b56  uint8_t *%s    a block of the program's memory (the background image sits 256 bytes into it)
background        0x00000182  uint8_t *%s    where the background image is
background_loaded 0x00000276  uint16_t %s    non-zero: the background image has been loaded
screen_prepared   0x00000398  uint16_t %s    non-zero: the password screen has been set up
menu_state_25a    0x0000025a  uint16_t %s
line_text         0x000003a8  const uint8_t *%s   sixteen characters (in the program's numbering) that draw_line_text draws
cursor_pos        0x0000038e  uint16_t %s     which cell of the grid the cursor is at (bits 0 to 2 the column, 3 up the row)
cursor_frame      0x00000aa6  uint16_t %s     0 to 3: the frame of the cursor's animation
title_text        0x000003be  const char *%s
title_x           0x000003ba  int16_t %s
title_y           0x000003bc  int16_t %s
password_slots    0x00000d12  uint32_t %s[3]   the three saved codes (the first byte of each is 0 when there is none)
password_line     0x00006a0e  uint8_t %s[]    "pass N :" and then room for the three code characters (a line of text in the code that is changed)
record_text       0x000003c2  uint8_t %s[200]   ten records of 20 bytes: sixteen characters and four bytes
key_held          0x00000228  uint16_t %s     non-zero: the button is still down since it picked a cell of the grid
disk_digit        0x0001d487  uint8_t %s      the digit of the disk's name ("godsd2": the disk the loader asks for)
has_continue      0x0000027a  uint16_t %s     non-zero: there is a game to continue (the menu has a third line)
menu_item_count   0x00006384  uint16_t %s     the number of the last line of the menu (1 or 2; a word in the code that is changed)
table menu_texts      0x0000635a uint8_t 41   the main menu's lines, each ended by a 0: "BEGIN QUEST", "ENTER PASSWORD", "CONTINUE GAME"
table text_top_ten   0x000068c2 uint8_t 13   "TOP TEN GODS"
table text_enter_a   0x0000689c uint8_t 17   "ENTER A PASSWORD"
table key_table      0x00006ce0 uint8_t 40   the keys of the grid in the order of its cells (a to z, full stop, space, 0 to 9, backspace), ended by $FF
table tocache_name 0x000196fe uint8_t 12   "tocache.bin": the file with the directory of the disks (loaded at start)
asset_name        0x00000d1e  char %s[16]       the file name that assets_load puts together
picture_header    0x00000d42  uint16_t %s       the first word of the picture file (its resolution)
asset_directory   0x00000cea  uint8_t *%s       where the table of sprite records of an asset file is read (at +20)
asset_flag        0x0000023c  int16_t %s        negative: every sprite record is copied; otherwise a bit of shift_bits tells whether
shift_bits        0x00000bba  uint32_t %s       a shift register of random bits (refilled from shift_source)
shift_source      0x00000bbe  const uint32_t *%s
shift_count       0x0000023e  int16_t %s        bits left in shift_bits
asset_mem_end     0x00000d3e  uint8_t *%s       where assets_load stopped writing sprite data
asset_table_end   0x00000d3a  struct AssetEntry *%s   ... and where its table of entries ended
picture_buffer    0x00031fde  uint8_t %s[]      where a picture file is read to
table asset_extensions 0x00000d2e uint8_t 11   the endings of a picture file name (.pi1) and of its table (.dat, 6 bytes on)
table asset_names 0x0001ecec uint8_t 138   the names assets_load knows (each ended by 0, ended by $FF), and from byte 86 on a long for each: the address of its list of file names
menu_active      0x00000278  uint16_t %s     set when the menu program's main part has started
stack_top        0x00000e38  uint8_t *%s
asset_memory    0x00000e40  uint8_t *%s
ptr_0b5a          0x00000b5a  uint8_t *%s
ptr_0b5e          0x00000b5e  uint8_t *%s
ptr_03ac          0x000003ac  uint8_t *%s
ptr_0b52          0x00000b52  uint8_t *%s
ptr_0e4c          0x00000e4c  uint8_t *%s
ptr_0cee          0x00000cee  uint8_t *%s
ptr_0cc6          0x00000cc6  uint8_t *%s
ptr_0b86          0x00000b86  uint8_t *%s
ptr_0cc2          0x00000cc2  uint8_t *%s
ptr_0cda          0x00000cda  uint8_t *%s
ptr_0cfa         0x00000cfa  uint8_t *%s[5]   five pointers, 200 bytes apart (the first is set by memory_map_init)
ptr_0cba          0x00000cba  uint8_t *%s
ptr_0bce          0x00000bce  uint8_t *%s
ptr_0cce          0x00000cce  uint8_t *%s
ptr_0c9e          0x00000c9e  uint8_t *%s
ptr_0bb2          0x00000bb2  uint8_t *%s
ptr_0e44          0x00000e44  uint8_t *%s
ptr_0e5c          0x00000e5c  uint8_t *%s
ptr_0cb2          0x00000cb2  uint8_t *%s
ptr_0cbe          0x00000cbe  uint8_t *%s
ptr_0d0e          0x00000d0e  uint8_t *%s
ptr_0ce6          0x00000ce6  uint8_t *%s
ptr_0c9a          0x00000c9a  uint8_t *%s
ptr_0cf2          0x00000cf2  uint8_t *%s
restart_address   0x00000e48  uint8_t *%s
program_end       0x0003a670  uint8_t %s[]      the end of the program as the loader reads it: the memory map begins here
voice             0x0002034c  struct Voice %s[4]   the four voices of the sound system (the state of the sound system goes on after them)
voice_buffers     0x0002061c  uint8_t %s[]      a buffer of 128 bytes for each voice
sound_lock        0x0002079c  uint8_t %s        $FF while the sound system is being set up
table_199ac      0x000199ac  uint8_t %s[]      records of 36 bytes whose first long is a pointer (these are 140 bytes apart)     records of 36 bytes whose first long is a pointer (set up at the start)
data_1aa66        0x0001aa66  uint8_t %s[]
data_1ad8a        0x0001ad8a  uint8_t %s[]
data_1b17e        0x0001b17e  uint8_t %s[]
data_1b7be        0x0001b7be  uint8_t %s[]
data_1c302        0x0001c302  uint8_t %s[]
loading_text      0x0001d3f4  uint8_t %s[]      "loading game please wait"
palette_words     0x00000134  uint16_t %s[16]   the sixteen colours of the picture assets_load read last
first_asset_name  0x000196d6  char %s[]         "always": the name of the first asset set
key_modifiers     0x0001e69a  uint8_t %s[2]     the shift keys: non-zero while one is down
table keymap      0x0001e5ae uint8_t 128   the character a raw key code gives (0 when none)
data_1c5be        0x0001c5be  uint8_t %s[]
ptr_0e58          0x00000e58  uint8_t *%s
random_seed       0x0001d0aa  uint16_t %s       the seed of the program's random numbers (a word in the code)
word_037c         0x0000037c  uint16_t %s
word_5418         0x00005418  uint16_t %s
word_0240         0x00000240  uint16_t %s
word_01dc         0x000001dc  uint16_t %s
word_0248         0x00000248  uint16_t %s
asset_end_28ec    0x000028ec  uint8_t *%s       a copy of where assets_load ended
asset_table_28f0  0x000028f0  uint8_t *%s       ... and of its table's end
word_28ea         0x000028ea  uint16_t %s
asset_end_0ca2    0x00000ca2  uint8_t *%s
asset_table_0ca6  0x00000ca6  uint8_t *%s
word_025c         0x0000025c  uint16_t %s
word_0266         0x00000266  uint16_t %s
word_0384         0x00000384  uint16_t %s
flags_0ddd        0x00000ddd  uint8_t %s
