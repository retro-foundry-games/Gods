# The menu program's data: name, address, C declaration (%s is the name), what it is.  scripts/gen_menu_symbols.py writes
# native/menu_symbols.h (the declarations) and native/menu.ld (the names at their addresses), so the C names no address.
work_area         0x00000caa  uint32_t *%s    pointer to a buffer of 80 longs that clear_work_area clears
shadow_table      0x00000e10  uint16_t %s[]   a table of words indexed by shadow_set / shadow_get (colour register shadows)
mouse_x           0x0001e4fc  uint16_t %s     pointer position, 0 to $200 (moved by input_poll)
mouse_y           0x0001e4fe  uint16_t %s     pointer position, 0 to $C7
mouse_x_copy      0x0001e500  uint16_t %s
mouse_y_copy      0x0001e502  uint16_t %s
button_bits       0x0001e504  uint8_t %s[2]   bit 0: a button down (either), bit 1: the second; cleared at the start of every poll
mouse_counter     0x0001e506  uint16_t %s     JOY0DAT as last read: vertical counter in the high byte, horizontal in the low byte
mouse_counter_old 0x0001e508  uint16_t %s     the value before it
button_presses    0x0001e50a  uint8_t %s      bits set by input_poll (1 first button, 4 second or the pot lines), cleared by whoever reads them
pending_request   0x0001e5a8  uint32_t %s     non-zero: something is waiting to be taken (take_pending_request)
joystick          0x0001e5ac  uint8_t %s      bit 0 up, 1 down, 2 left, 3 right, 7 fire
heap_base         0x0000002c  uint32_t %s     where the program's memory starts (a vector slot the program uses for it)
mem_lists         0x0001d41c  struct MemLists %s   the allocator's two lists (alloc_init)
param_index       0x000001d4  uint16_t %s     which row of param_table select_params takes (1 to 4)
param_a           0x0000024c  uint32_t %s     set by select_params
param_b           0x00000250  uint32_t %s
param_c           0x00000254  uint16_t %s
param_d           0x00000256  uint16_t %s
entry_list        0x00000cae  struct Entry8 *%s   a list of address/size entries that assign_addresses fills in
words_source      0x00000cbe  const uint16_t *%s   words that narrow_words_to_bytes makes bytes of
bytes_dest        0x00000cc2  uint8_t *%s     ... and where the bytes go
buffer_cb6        0x00000cb6  uint8_t *%s     a buffer of 2400 bytes that load_buffer_2400 fills
saved_slot_words  0x000148e8  uint16_t %s[22]   two words of each of the eleven slots, put away by save_slot_words
object_slots      0x00014988  struct Rec80 %s[11]   eleven records of 80 bytes
table_14cf8       0x00014cf8  struct Rec10 %s[132]   built by build_table_14cf8
marker_table      0x0001a3fc  uint32_t %s[100]   set to -1 by reset_marker_table
record_table      0x0001a58c  struct Rec6 %s[200]   copied in by copy_record_table
entry_table       0x0003a25e  struct Rec6 %s[50]   cleared by clear_entry_table
table param_table  0x000029da uint16_t 24   four rows of 12 bytes (two longs, two words) that select_params takes
table offsets_4cba 0x00004cba uint8_t 132   signed bytes that build_table_14cf8 puts in the table
blit_extra_modulo 0x000003b4  uint16_t %s     the blitter's extra modulo for the masked blit (0 unless set)
blit_plane_stride 0x000003b6  uint32_t %s     bytes from one plane of the screen to the next
mask_buffer       0x00000e48  uint16_t *%s    the buffer the blit makes its mask in
screen_buffer     0x00000e60  uint8_t *%s     the screen that is drawn to
image_table       0x00000e3c  struct Image *%s   the images (and glyphs) of the program
glyph_plane_size  0x00000280  uint16_t %s     non-zero: bytes of one plane of a glyph, otherwise worked out from its height
x_offset          0x0001d3a4  int16_t %s      added to the x of everything that is drawn
glyph_base        0x00000270  uint16_t %s     added to the index of what draw_string_small and the digit printer draw (the small font)
text_y            0x00012d5a  uint16_t %s     the row text_draw_centered draws at (a word in the middle of the code)
last_request      0x0000049e  uint16_t %s     the request next_request returned last time
repeat_delay      0x0000049c  int16_t %s      frames before next_request repeats a request that is held; counted down elsewhere
screen_other      0x00000e64  uint8_t *%s     the other screen: the one that is shown while screen_buffer is drawn on
copper_save       0x00000e50  uint16_t *%s    where copper_colors_save puts the colours of the copper list, and the fades take their target from
palette_dirty     0x00000e0e  uint16_t %s     non-zero: the vertical blank copies the shadow table to the colour registers
buffer_state      0x00000de4  struct Rec6 %s[2]   what is kept for each of the two screens; swapped when they are
vbl_saturating    0x0001d058  uint16_t %s     frames since the last flip, stops at $7FFF
vbl_count         0x0001d05a  uint16_t %s     frames, wraps
copper_colors     0x00004e3a  uint16_t %s[]   the part of the copper list that has the moves to COLOR01 (the colour of each band)
copper_list_a     0x00004d8a  uint8_t %s[]    the copper list of one screen
copper_list_b     0x00004dde  uint8_t %s[]    ... and of the other
screen_1          0x0006f800  uint8_t %s[]    the two screens
screen_2          0x00077c00  uint8_t %s[]
